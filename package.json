{
  "name": "rue",
  "version": "0.1.0",
  "type": "module",
  "description": "A logic engine built for authorship and explainable simulation",
  "keywords": ["logic", "rules", "social-simulation", "datalog", "predicate", "game-ai", "narrative"],
  "author": "Mike Treanor (https://mtreanor.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtreanor/rue"
  },
  "homepage": "https://github.com/mtreanor/rue",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "tool": "npm run --prefix tools/action-rule-set-tool start",
    "tool:dev": "npm run --prefix tools/action-rule-set-tool dev",
    "demo": "node src/repl.js",
    "demo:planner": "node examples/planner.js",
    "demo:landing-page": "node examples/landing-page-demo.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.4"
  }
}
