{
  "name": "ruse",
  "displayName": "ruse",
  "description": "Syntax highlighting for the ruse logic DSL",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "ruse",
        "aliases": ["ruse"],
        "extensions": [".ruse"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ruse",
        "scopeName": "source.ruse",
        "path": "./ruse.tmLanguage.json"
      }
    ]
  }
}
