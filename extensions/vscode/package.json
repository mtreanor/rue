{
  "name": "rue",
  "displayName": "RUE",
  "description": "Syntax highlighting for the RUE logic DSL",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "rue",
        "aliases": ["RUE", "rue"],
        "extensions": [".rue"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rue",
        "scopeName": "source.rue",
        "path": "./rue.tmLanguage.json"
      }
    ]
  }
}
